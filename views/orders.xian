{{> head}}<body><div class="min-h-screen md:flex"><aside class="sidebar md:w-60 p-5 shrink-0"><a class="app-brand" href="/dashboard"><span class="brand-mark">R</span><span>Resto<strong>Flow</strong></span><small>Restaurant ordering</small></a><nav class="space-y-1"><a class="block rounded px-3 py-2" href="{{#if isCustomer}}/menu{{else}}/dashboard{{/if}}">Back</a><a class="block rounded px-3 py-2 mt-8 text-red-300" href="/logout">Log out</a></nav></aside><main class="flex-1 p-5 md:p-8 max-w-7xl"><div class="welcome-bar">{{#if isCustomer}}My orders{{else}}Welcome Back, {{currentUser}}!{{/if}}</div>{{#if success_msg}}<div class="notice notice-success">{{success_msg}}</div>{{/if}}{{#if error_msg}}<div class="notice notice-error">{{error_msg}}</div>{{/if}}<div class="flex justify-between items-center mb-6"><h1 class="text-3xl font-bold">{{#if isCustomer}}My orders{{else}}Orders{{/if}}</h1>{{#unless isCustomer}}<a href="/orders/new" class="btn btn-primary">+ New order</a>{{/unless}}</div>
<form class="card p-4 mb-5 flex flex-wrap gap-3"><input class="field md:w-64" name="search" value="{{filters.search}}" placeholder="Order number or customer"><select class="field md:w-40" name="status"><option value="">All statuses</option><option>Pending</option><option>Preparing</option><option>Ready</option><option>Completed</option><option>Cancelled</option></select><input class="field md:w-40" type="date" name="date" value="{{filters.date}}"><button class="btn btn-primary">Filter</button></form>
<div class="card overflow-hidden"><div class="overflow-x-auto"><table class="w-full text-left text-sm"><thead class="bg-slate-50"><tr><th class="p-3">Order</th><th class="p-3">Customer</th><th class="p-3">Items</th><th class="p-3">Payment</th><th class="p-3">Total</th><th class="p-3">Status</th></tr></thead><tbody>{{#each orders}}<tr class="border-t align-top"><td class="p-3 font-medium">{{orderNumber}}<div class="text-xs text-slate-500">{{orderType}}</div></td><td class="p-3">{{customerName}}</td><td class="p-3">{{#each items}}{{quantity}} × {{menuItem.name}}<br>{{/each}}</td><td class="p-3">{{payment.method}}<div class="text-xs text-slate-500">{{payment.status}}</div></td><td class="p-3">₱{{total}}</td><td class="p-3">{{#if ../isCustomer}}<span class="status-label">{{status}}</span>{{else}}<form method="post" action="/orders/{{id}}/status"><select class="field text-xs" name="status" onchange="this.form.submit()"><option value="">Update status</option><option>Confirmed</option><option>Preparing</option><option>Ready</option><option>Completed</option><option>Cancelled</option></select></form>{{/if}}</td></tr>{{else}}<tr><td class="p-5 text-slate-500" colspan="6">No matching orders.</td></tr>{{/each}}</tbody></table></div></div></main></div>{{> footer}}

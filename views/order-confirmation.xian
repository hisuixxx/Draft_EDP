{{> head}}<body><main class="max-w-3xl mx-auto p-5 md:p-10"><div class="card p-6 md:p-10 text-center"><p class="eyebrow">ORDER RECEIVED</p><h1 class="text-3xl font-bold mt-2">Thank you, {{order.customerName}}!</h1><p class="text-slate-500 mt-2">Your order has been placed successfully.</p><div class="notice notice-success text-left mt-6">Order <strong>{{order.orderNumber}}</strong> is currently <strong>{{order.status}}</strong>.</div><div class="text-left border-t mt-6 pt-5">{{#each order.items}}<div class="flex justify-between py-2"><span>{{quantity}} × {{menuItem.name}}</span><strong>₱{{price}}</strong></div>{{/each}}<div class="flex justify-between border-t mt-3 pt-3 text-lg"><strong>Total</strong><strong>₱{{order.total}}</strong></div></div><div class="flex justify-center gap-3 mt-7"><a class="btn btn-primary" href="/orders">Track my orders</a><a class="btn" href="/menu">Back to menu</a></div></div></main><script>localStorage.removeItem("restoflow-cart");localStorage.removeItem("xianfire-cart");</script>{{> footer}}

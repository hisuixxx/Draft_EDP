{{> head}}
<body class="auth-page">
  <div class="auth-shell"><a class="brand auth-brand" href="/menu"><span class="brand-mark">R</span>Resto<strong>Flow</strong></a><div class="auth-card">
    {{#if error_msg}}<div class="notice notice-error">{{error_msg}}</div>{{/if}}
    <p class="eyebrow"></p><h1>Create your account</h1><p class="muted">Save your details and keep track of every order.</p>
    <form method="POST" action="/register" class="auth-form"><label>Full name<input type="text" name="name" placeholder="Your name" class="field" required /></label><label>Email<input type="email" name="email" placeholder="you@example.com" class="field" required /></label><label>Password<input type="password" name="password" placeholder="At least 6 characters" class="field" minlength="6" required /></label><button type="submit" class="btn btn-primary">Create account <span>→</span></button></form>
    <p class="auth-switch">Already have an account? <a href="/login">Sign in</a></p>
  </div></div>
{{> footer }}

{{> head}}<body><div class="min-h-screen md:flex"><aside class="sidebar md:w-60 p-5 shrink-0"><a class="app-brand" href="/dashboard"><span class="brand-mark">R</span><span>Resto<strong>Flow</strong></span><small>Restaurant ordering</small></a><nav class="space-y-1"><a class="block rounded px-3 py-2" href="/dashboard">Dashboard</a><a class="block rounded px-3 py-2" href="/orders">Orders</a><a class="block rounded px-3 py-2" href="/menu">Menu</a><a class="block rounded px-3 py-2" href="/reports">Reports</a><a class="block rounded px-3 py-2 mt-8 text-red-300" href="/logout">Log out</a></nav></aside><main class="flex-1 p-5 md:p-8 max-w-5xl"><div class="flex justify-between mb-6"><h1 class="text-3xl font-bold">Sales reports</h1><button class="btn btn-primary" onclick="window.print()">Print report</button></div><div class="card overflow-hidden"><table class="w-full text-left"><thead class="bg-slate-50"><tr><th class="p-3">Date</th><th class="p-3">Orders</th><th class="p-3 text-right">Sales</th></tr></thead><tbody>{{#each reports}}<tr class="border-t"><td class="p-3">{{day}}</td><td class="p-3">{{orders}}</td><td class="p-3 text-right">₱{{sales}}</td></tr>{{else}}<tr><td class="p-5 text-slate-500" colspan="3">No completed sales yet.</td></tr>{{/each}}</tbody></table></div></main></div>{{> footer}}

{{> head}}<body><div class="min-h-screen md:flex"><aside class="sidebar md:w-60 p-5 shrink-0"><a class="app-brand" href="/dashboard"><span class="brand-mark">R</span><span>Resto<strong>Flow</strong></span><small>Admin workspace</small></a><nav class="space-y-1"><a class="block rounded px-3 py-2" href="/dashboard">Dashboard</a><a class="block rounded px-3 py-2" href="/orders">Orders</a><a class="block rounded px-3 py-2" href="/manage/menu">Menu</a><a class="block rounded px-3 py-2 active" href="/reports">Reports</a><a class="block rounded px-3 py-2 mt-8 text-red-300" href="/logout">Log out</a></nav></aside><main class="flex-1 p-5 md:p-8 max-w-5xl"><div class="flex justify-between mb-6"><div><p class="eyebrow">BUSINESS INTELLIGENCE</p><h1>Sales reports</h1></div><div class="flex gap-2"><button class="btn" onclick="window.print()">Print</button><a class="btn btn-primary" href="/reports.csv?from={{filters.from}}&amp;to={{filters.to}}">Export CSV</a></div></div><form class="card p-4 mb-5 flex flex-wrap gap-3 items-end"><label>From<input class="field mt-1" type="date" name="from" value="{{filters.from}}"></label><label>To<input class="field mt-1" type="date" name="to" value="{{filters.to}}"></label><button class="btn btn-primary" type="submit">Apply dates</button></form><div class="card overflow-hidden"><table class="w-full text-left"><thead class="bg-slate-50"><tr><th class="p-3">Date</th><th class="p-3">Orders</th><th class="p-3 text-right">Sales</th></tr></thead><tbody>{{#each reports}}<tr class="border-t"><td class="p-3">{{day}}</td><td class="p-3">{{orders}}</td><td class="p-3 text-right">₱{{sales}}</td></tr>{{else}}<tr><td class="p-5 text-slate-500" colspan="3">No completed sales yet.</td></tr>{{/each}}</tbody></table></div></main></div>{{> footer}}

{{> head}}
<body><div class="min-h-screen md:flex"><aside class="sidebar md:w-60 p-5 shrink-0"><a class="app-brand" href="/dashboard"><span class="brand-mark">R</span><span>Resto<strong>Flow</strong></span><small>Admin workspace</small></a><nav class="space-y-1"><a class="block rounded px-3 py-2" href="/dashboard">Overview</a><a class="block rounded px-3 py-2" href="/manage/menu">Products</a><a class="block rounded px-3 py-2 active" href="/categories">Categories</a><a class="block rounded px-3 py-2" href="/settings">Settings</a><a class="block rounded px-3 py-2 mt-8 text-red-300" href="/logout">Log out</a></nav></aside><main class="flex-1 p-5 md:p-8 max-w-5xl"><div class="welcome-bar">Welcome back, {{currentUser}}.</div>{{#if success_msg}}<div class="notice notice-success">{{success_msg}}</div>{{/if}}{{#if error_msg}}<div class="notice notice-error">{{error_msg}}</div>{{/if}}<div class="mb-7"><p class="eyebrow">CATALOG CONTROL</p><h1>Categories</h1><p class="muted">Organize products into reusable menu groups.</p></div><section class="card p-5 mb-6"><form method="post" action="/categories" class="grid md:grid-cols-3 gap-3 items-end"><label>Name<input class="field mt-1" name="name" maxlength="80" required></label><label>Description<input class="field mt-1" name="description" maxlength="255"></label><button class="btn btn-primary" type="submit">Add category</button></form></section><section class="card overflow-hidden"><table class="w-full text-left text-sm"><thead><tr><th class="p-3">Name</th><th class="p-3">Description</th><th class="p-3">Status</th><th class="p-3">Action</th></tr></thead><tbody>{{#each categories}}<tr class="border-t"><td class="p-3 font-semibold">{{name}}</td><td class="p-3">{{description}}</td><td class="p-3">{{#if active}}Active{{else}}Archived{{/if}}</td><td class="p-3"><form method="post" action="/categories/{{id}}/toggle"><button class="text-emerald-800 font-semibold" type="submit">{{#if active}}Archive{{else}}Activate{{/if}}</button></form></td></tr>{{else}}<tr><td class="p-5 text-slate-500" colspan="4">No categories yet.</td></tr>{{/each}}</tbody></table></section></main></div>{{> footer}}

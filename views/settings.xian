{{> head}}
<body><div class="min-h-screen md:flex"><aside class="sidebar md:w-60 p-5 shrink-0"><a class="app-brand" href="/dashboard"><span class="brand-mark">R</span><span>Resto<strong>Flow</strong></span><small>Admin workspace</small></a><nav class="space-y-1"><a class="block rounded px-3 py-2" href="/dashboard">Overview</a><a class="block rounded px-3 py-2" href="/categories">Categories</a><a class="block rounded px-3 py-2 active" href="/settings">Settings</a><a class="block rounded px-3 py-2 mt-8 text-red-300" href="/logout">Log out</a></nav></aside><main class="flex-1 p-5 md:p-8 max-w-4xl"><div class="welcome-bar">Welcome back, {{currentUser}}.</div>{{#if success_msg}}<div class="notice notice-success">{{success_msg}}</div>{{/if}}{{#if error_msg}}<div class="notice notice-error">{{error_msg}}</div>{{/if}}<div class="mb-7"><p class="eyebrow">RESTAURANT SETTINGS</p><h1>Restaurant settings</h1><p class="muted">Configure the public restaurant information.</p></div><form method="post" action="/settings" class="card p-5 grid gap-4"><label>Restaurant name<input class="field mt-1" name="restaurantName" value="{{settings.restaurantName}}" maxlength="255" required></label><label>Description<textarea class="field mt-1" name="restaurantDescription" maxlength="1000" rows="3">{{settings.restaurantDescription}}</textarea></label><label>Contact phone<input class="field mt-1" name="contactPhone" value="{{settings.contactPhone}}" maxlength="100"></label><label>Address<input class="field mt-1" name="address" value="{{settings.address}}" maxlength="255"></label><label>Opening hours<input class="field mt-1" name="openingHours" value="{{settings.openingHours}}" maxlength="255"></label><button class="btn btn-primary" type="submit">Save settings</button></form></main></div>{{> footer}}
